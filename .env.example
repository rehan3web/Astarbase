# Docker Compose automatically loads .env next to docker-compose.yml.
# Copy this file to .env and supply your own strong credentials before startup.
DB_NAME=astarbase
DB_USER=astarbase_admin
# At least 16 characters; quote values containing $ or # with single quotes.
DB_PASSWORD=
# At least 32 characters; server-to-server API secret, NOT a login.
ADMIN_API_TOKEN=
# New private cookie-signing secret: at least 32 characters, different from
# ADMIN_API_TOKEN. Never reuse the old login token here.
SESSION_SECRET=
# First-run admin login. Existing accounts are never overwritten on restart.
# Username: 3–48 letters/numbers/._-. Password: 12–256 characters.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# After the first successful startup, ADMIN_PASSWORD may be removed from .env.
# The salted password hash remains in Backend/data/admin.sqlite.
POSTGRES_CONTAINER=astarbase-postgres
POSTGRES_PUBLIC_PORT=5432
PGBOUNCER_PUBLIC_PORT=6432
ADMIN_PORT=8000
STUDIO_PORT=5000
# Set true when Studio is served behind an HTTPS reverse proxy.
STUDIO_COOKIE_SECURE=false
SQL_TIMEOUT_MS=30000
# Optional read-only import from the previous version's admin metadata.
LEGACY_CONTROL_DB=astarbase_control
