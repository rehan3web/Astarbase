    "test:recovery": "RUN_SOCKET_INTEGRATION=1 tsx --test test/password-recovery.integration.test.ts",
    "db:push": "tsx src/db/push.ts",
    "setup": "tsx src/setup.ts"
  },
  "keywords": [],
