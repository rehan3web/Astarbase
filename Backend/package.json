  "version": "1.0.0",
  "description": "",
  "private": true,
  "engines": { "node": ">=24" },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
