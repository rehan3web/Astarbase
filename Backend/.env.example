
DB_NAME=sorabase
DB_USER=sorabase_admin
# Supply your own strong values in Backend/.env; do not commit it.
DB_PASSWORD=
ADMIN_API_TOKEN=
# Only for importing metadata from the previous backend; no control DB is created.
LEGACY_CONTROL_DB=sorabase_control
# SQLite defaults to Backend/data/admin.sqlite.
# ADMIN_DATA_DIR=/absolute/path/to/Backend/data
COMPOSE_PROJECT_NAME=sorabase
POSTGRES_CONTAINER=sorabase-postgres
PG_SOCKET_DIR=/var/run/postgresql
DOCKER_SOCKET=/var/run/docker.sock
POSTGRES_PUBLIC_PORT=5432
PGBOUNCER_PUBLIC_PORT=6432
ADMIN_PORT=8000
PORT=8000
# true on the host; Compose overrides this to false inside the API container.
AUTO_START_COMPOSE=true
SQL_TIMEOUT_MS=30000
STUDIO_PORT=5000
# Enable when serving Studio behind an HTTPS reverse proxy.
STUDIO_COOKIE_SECURE=false
